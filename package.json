{
  "name": "dsa-meisterwerkzeug",
  "version": "1.0.0",
  "description": "Game master toolkit for Das Schwarze Auge 5 (DSA5) in Obsidian (German UI)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "gen:talents": "node scripts/gen-talents.mjs",
    "report:bestiary": "vitest run tests/bestiary.real.test.ts --reporter=verbose",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "builtin-modules": "^5.5.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdhertel/dsa-meisterwerkzeug.git"
  },
  "bugs": {
    "url": "https://github.com/cmdhertel/dsa-meisterwerkzeug/issues"
  },
  "homepage": "https://github.com/cmdhertel/dsa-meisterwerkzeug#readme",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "dsa",
    "dsa5",
    "das-schwarze-auge",
    "ttrpg",
    "game-master"
  ]
}
