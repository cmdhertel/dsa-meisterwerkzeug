{
  "compilerOptions": {
    "inlineSourceMap": false,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": false,
    "noImplicitAny": true,
    "strict": true,
    "moduleResolution": "bundler",
    "importHelpers": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["DOM", "ES2020"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
